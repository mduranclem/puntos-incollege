{
  "name": "@puntos/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "simular": "tsx src/scripts/simular.ts",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate deploy",
    "prisma:migrate:dev": "prisma migrate dev",
    "seed": "tsx src/scripts/sembrar.ts",
    "tareas": "tsx src/tareas.ts",
    "tareas:prod": "node dist/tareas.js",
    "pg:local": "tsx src/scripts/pgliteServidor.ts",
    "probar:local": "tsx src/scripts/probarCicloLocal.ts",
    "preparar:local": "tsx src/scripts/prepararLocal.ts",
    "probar:acceso": "tsx src/scripts/probarAccesoLocal.ts",
    "limpiar:avisos": "tsx src/scripts/limpiarAvisosDePrueba.ts",
    "probar:concurrencia": "tsx src/scripts/probarConcurrencia.ts"
  },
  "prisma": {
    "seed": "tsx src/scripts/sembrar.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.2.1",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.3.8",
    "@electric-sql/pglite-socket": "^0.0.13",
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.10.5",
    "prisma": "^6.2.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
  }
}