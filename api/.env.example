# Base de datos
DATABASE_URL="postgresql://puntos:puntos@localhost:5432/puntos_incollege?schema=public"
# Base para los tests de integración. Si no está, esos tests se saltean (D-015).
DATABASE_URL_TEST=""

# API
PORT=3001
CORS_ORIGEN="http://localhost:5173"

# Secretos (cambiar en producción)
JWT_SECRET="cambiar-en-produccion"
TOKEN_CLIENTE_SECRET="cambiar-en-produccion-tambien"
TOKEN_CLIENTE_DIAS=180

# URL pública del frontend, para armar el link de saldo que va por WhatsApp
URL_PUBLICA_WEB="http://localhost:5173"

# Avisos por WhatsApp (D-014): la API postea acá, n8n habla con Evolution API
N8N_WEBHOOK_URL=""
N8N_WEBHOOK_TOKEN=""

# Tarea programada de vencimiento (D-013) y despachador de avisos
CRON_HABILITADO=false
