# Base de datos
DATABASE_URL="postgresql://puntos:puntos@localhost:5432/puntos_incollege?schema=public"
# Base para los tests de integración. Si no está, esos tests se saltean (D-015).
DATABASE_URL_TEST=""

# API
PORT=3001
CORS_ORIGEN="http://localhost:5173"

# Secretos. Estos valores de ejemplo **no funcionan**: el sistema se niega a
# arrancar con ellos, y también si faltan o son cortos (D-044). Generá los tuyos:
#   node -e "console.log(require('crypto').randomBytes(36).toString('base64url'))"
JWT_SECRET="cambiar-en-produccion"
TOKEN_CLIENTE_SECRET="cambiar-en-produccion-tambien"
# Cuánto dura la sesión del cliente en la app.
TOKEN_CLIENTE_DIAS=30

# URL pública del frontend, para armar el link de saldo que va por WhatsApp
URL_PUBLICA_WEB="http://localhost:5173"

# Avisos por WhatsApp (D-014): la API postea acá, n8n habla con Evolution API.
# La URL es la "Production URL" del nodo Webhook del workflow
# "Puntos InCollege - Avisos de WhatsApp". El token tiene que ser el mismo que
# figura en la constante TOKEN del nodo "Armar el mensaje".
N8N_WEBHOOK_URL=""
N8N_WEBHOOK_TOKEN=""

# Tarea programada de vencimiento (D-013) y despachador de avisos
CRON_HABILITADO=false

# Contraseñas iniciales del personal. Sin estas el seed no crea usuarios en
# producción (D-029). Quedan marcadas para cambio obligatorio al entrar (D-034).
SEED_CONTRASENA_ADMIN=""
SEED_CONTRASENA_VENDEDOR=""
